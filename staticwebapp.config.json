{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    {
      "route": "/admin",
      "redirect": "/admin/",
      "statusCode": 301
    },
    {
      "route": "/admin/*",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "route": "/checkout",
      "rewrite": "/pages/checkout.html"
    },
    {
      "route": "/*.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/css/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/js/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/data/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/og-image.*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/admin/*",
      "/api/*",
      "/images/*",
      "/data/*",
      "/*.svg",
      "/*.png",
      "/*.jpg",
      "/*.webp",
      "/*.ico",
      "/*.txt",
      "/*.xml",
      "/*.json"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob: https://*.blob.core.windows.net https://*.azurestaticapps.net; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
  },
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".webp": "image/webp"
  }
}
